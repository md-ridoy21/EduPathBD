# Copy to a deployment-secret store or an untracked .env file. Never commit real values.
POSTGRES_DB=edupath
POSTGRES_USER=edupath
POSTGRES_PASSWORD=GENERATE_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://edupath:URL_ENCODED_PASSWORD@postgres:5432/edupath
JWT_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
WEB_ORIGINS=https://app.example.com
API_BIND_ADDRESS=127.0.0.1
API_PORT=4000

# Keep this secret separate from the database password. Backups are encrypted
# before they enter the persistent backup volume.
BACKUP_ENCRYPTION_KEY=GENERATE_A_SEPARATE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
BACKUP_RETENTION_COUNT=14

FIREBASE_PROJECT_ID=your-firebase-project-id
# Prefer an externally mounted credential file in production.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-admin.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# Public Firebase web configuration. These values are embedded in the client;
# they are not Firebase Admin credentials or server secrets.
VITE_FIREBASE_API_KEY=your-public-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-public-firebase-web-app-id
VITE_FIREBASE_PHONE_TEST_MODE=false

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=sb_secret_create_a_dedicated_server_key
# Legacy migration fallback only. Leave empty for new deployments.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=edupath-media

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
