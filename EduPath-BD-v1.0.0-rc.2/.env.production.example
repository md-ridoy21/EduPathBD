# Copy to a deployment-secret store or an untracked .env file. Never commit real values.
POSTGRES_DB=edupath
POSTGRES_USER=edupath
POSTGRES_PASSWORD=GENERATE_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://edupath:URL_ENCODED_PASSWORD@postgres:5432/edupath
JWT_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
WEB_ORIGINS=https://app.example.com
API_BIND_ADDRESS=127.0.0.1
API_PORT=4000

# Keep this secret separate from the database password. Backups are encrypted
# before they enter the persistent backup volume.
BACKUP_ENCRYPTION_KEY=GENERATE_A_SEPARATE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
BACKUP_RETENTION_COUNT=14

FIREBASE_PROJECT_ID=your-firebase-project-id
# Choose exactly one server credential method. Prefer the standard file path for
# local/operator runs; managed hosts can provide Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=sb_secret_create_a_dedicated_server_key
# Legacy migration fallback only. Leave empty for new deployments.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=edupath-media

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# These Firebase web-app values are public client configuration, not Admin secrets.
# They are embedded at web/Android build time. Never place a service-account key here.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
# Keep false for a public release. Set true only for a controlled academic build
# that accepts a fictional test number/code configured in Firebase Console.
VITE_FIREBASE_PHONE_TEST_MODE=false
