new file mode 100644
index 0000000..1c601eb
--- /dev/null
+++ b/scripts/verify-production-config.mjs
@@ -0,0 +1,47 @@
+#!/usr/bin/env node
+const failures = [];
+const warnings = [];
+const env = process.env;
+const present = (name) => typeof env[name] === "string" && env[name].trim().length > 0;
+const placeholder = (value = "") => /replace|change-before|example|your-|dummy|demo-secret|generate[_ -]?a/i.test(value);
+
+if (env.NODE_ENV !== "production") failures.push("NODE_ENV must be production");
+if (String(env.DEMO_MODE).toLowerCase() !== "false") failures.push("DEMO_MODE must be false");
+if (!present("DATABASE_URL") || !/^postgres(?:ql)?:\/\//i.test(env.DATABASE_URL) || placeholder(env.DATABASE_URL)) failures.push("DATABASE_URL must be a non-placeholder PostgreSQL connection string");
+if (!present("JWT_SECRET") || env.JWT_SECRET.length < 48 || placeholder(env.JWT_SECRET)) failures.push("JWT_SECRET must be a non-placeholder secret of at least 48 characters");
+if (!present("WEB_ORIGINS")) failures.push("WEB_ORIGINS must be set explicitly");
+if (!present("FIREBASE_PROJECT_ID") || placeholder(env.FIREBASE_PROJECT_ID)) failures.push("FIREBASE_PROJECT_ID is required and must not be a placeholder");
+if (!present("FIREBASE_SERVICE_ACCOUNT_JSON")) failures.push("FIREBASE_SERVICE_ACCOUNT_JSON is required for Firebase Admin verification");
+else {
+  try { const parsed = JSON.parse(env.FIREBASE_SERVICE_ACCOUNT_JSON); if (!parsed.project_id || placeholder(String(parsed.project_id))) failures.push("FIREBASE_SERVICE_ACCOUNT_JSON must target the real Firebase project"); }
+  catch { failures.push("FIREBASE_SERVICE_ACCOUNT_JSON must contain valid JSON"); }
+}
+if (!present("SUPABASE_URL") || !/^https:\/\//i.test(env.SUPABASE_URL) || placeholder(env.SUPABASE_URL)) failures.push("SUPABASE_URL must be a non-placeholder HTTPS URL");
+if (!present("SUPABASE_SERVICE_ROLE_KEY") || placeholder(env.SUPABASE_SERVICE_ROLE_KEY)) failures.push("SUPABASE_SERVICE_ROLE_KEY is required for production media upload");
+if (!present("SUPABASE_STORAGE_BUCKET")) warnings.push("SUPABASE_STORAGE_BUCKET is unset; edupath-media will be used");
+if (!present("GEMINI_API_KEY")) warnings.push("GEMINI_API_KEY is unset; generative-AI proof will use the deterministic fallback instead");
+for (const name of ["VITE_FIREBASE_API_KEY", "VITE_FIREBASE_AUTH_DOMAIN", "VITE_FIREBASE_PROJECT_ID", "VITE_FIREBASE_APP_ID"]) {
+  if (!present(name) || placeholder(env[name])) failures.push(`${name} is required for the production Firebase client`);
+}
+if (String(env.VITE_FIREBASE_PHONE_TEST_MODE).toLowerCase() === "true") failures.push("VITE_FIREBASE_PHONE_TEST_MODE must not be true for a production release");
+
+if (present("VITE_API_URL") && !/^https:\/\//i.test(env.VITE_API_URL)) failures.push("VITE_API_URL must use HTTPS for a production Android/Web build");
+
+const summary = {
+  nodeEnv: env.NODE_ENV || "missing",
+  demoMode: env.DEMO_MODE || "missing",
+  database: present("DATABASE_URL"),
+  firebase: present("FIREBASE_PROJECT_ID") && present("FIREBASE_SERVICE_ACCOUNT_JSON"),
+  supabaseStorage: present("SUPABASE_URL") && present("SUPABASE_SERVICE_ROLE_KEY"),
+  generativeAi: present("GEMINI_API_KEY"),
+  apiUrlHttps: !present("VITE_API_URL") || /^https:\/\//i.test(env.VITE_API_URL)
+};
+
+console.log("EduPath BD production configuration check");
+console.table(summary);
+for (const warning of warnings) console.warn(`WARN: ${warning}`);
+if (failures.length) {
+  for (const failure of failures) console.error(`FAIL: ${failure}`);
+  process.exit(1);
+}
+console.log("Production configuration gate passed. No secret values were printed.");
