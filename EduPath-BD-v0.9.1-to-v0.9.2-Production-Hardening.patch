--- /dev/null
+++ b/scripts/build-android-release.mjs
@@ -0,0 +1,112 @@
+import { createHash } from "node:crypto";
+import { spawnSync } from "node:child_process";
+import { copyFileSync, createReadStream, existsSync, mkdirSync } from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import process from "node:process";
+
+const args = process.argv.slice(2);
+const readArg = (name) => {
+  const equals = args.find((item) => item.startsWith(`${name}=`));
+  if (equals) return equals.slice(name.length + 1);
+  const index = args.indexOf(name);
+  return index >= 0 ? args[index + 1] : undefined;
+};
+const apiUrl = readArg("--api-url") ?? process.env.VITE_API_URL;
+const prepareOnly = args.includes("--prepare-only");
+
+if (!apiUrl) {
+  console.error("Usage: npm run android:release -- --api-url https://api.example.com");
+  process.exit(1);
+}
+let parsedUrl;
+try { parsedUrl = new URL(apiUrl); } catch { console.error("The production API URL is invalid."); process.exit(1); }
+if (parsedUrl.protocol !== "https:") {
+  console.error("Release Android builds require an HTTPS API URL.");
+  process.exit(1);
+}
+if (["localhost", "127.0.0.1"].includes(parsedUrl.hostname)) {
+  console.error("Release Android builds cannot target localhost.");
+  process.exit(1);
+}
+
+const signingNames = ["EDUPATH_KEYSTORE_PATH", "EDUPATH_KEYSTORE_PASSWORD", "EDUPATH_KEY_ALIAS", "EDUPATH_KEY_PASSWORD"];
+const missingSigning = signingNames.filter((name) => !process.env[name]);
+if (!prepareOnly && missingSigning.length) {
+  console.error(`Release signing is incomplete. Missing: ${missingSigning.join(", ")}`);
+  process.exit(1);
+}
+if (!prepareOnly && !existsSync(process.env.EDUPATH_KEYSTORE_PATH)) {
+  console.error("EDUPATH_KEYSTORE_PATH does not point to a readable keystore file.");
+  process.exit(1);
+}
+
+function run(command, commandArgs, options = {}) {
+  console.log(`\n> ${command} ${commandArgs.join(" ")}`);
+  const result = spawnSync(command, commandArgs, { stdio: "inherit", shell: process.platform === "win32", ...options });
+  if (result.status !== 0) process.exit(result.status ?? 1);
+}
+function firstExisting(paths) { return paths.filter(Boolean).find((candidate) => existsSync(candidate)); }
+function javaMajor(javaBinary) {
+  const result = spawnSync(javaBinary, ["-version"], { encoding: "utf8" });
+  return Number(`${result.stdout ?? ""}\n${result.stderr ?? ""}`.match(/version "(\d+)/)?.[1] ?? 0);
+}
+
+const node = process.execPath;
+run(node, ["scripts/verify-production-config.mjs"], { env: { ...process.env, VITE_API_URL: parsedUrl.href.replace(/\/$/, "") } });
+const npm = process.platform === "win32" ? "npm.cmd" : "npm";
+run(npm, ["run", "build", "--workspace", "@edupath/web"], { env: { ...process.env, NODE_ENV: "production", VITE_API_URL: parsedUrl.href.replace(/\/$/, "") } });
+run(npm, ["run", "cap:sync", "--workspace", "@edupath/web"], { env: { ...process.env, CAPACITOR_ALLOW_MIXED_CONTENT: "false" } });
+
+if (prepareOnly) {
+  console.log("\nRelease project prepared with HTTPS-only API configuration. Open apps/web/android in Android Studio and configure signing there.");
+  process.exit(0);
+}
+
+const androidDir = path.resolve("apps/web/android");
+const wrapper = path.join(androidDir, process.platform === "win32" ? "gradlew.bat" : "gradlew");
+const home = os.homedir();
+const javaHomes = [
+  process.env.JAVA_HOME,
+  process.platform === "win32" ? "" : "/usr/lib/jvm/java-21-openjdk-amd64",
+  process.platform === "win32" ? "C:\\Program Files\\Android\\Android Studio\\jbr" : "",
+  "/opt/android-studio/jbr",
+  path.join(home, "android-studio", "jbr")
+].filter(Boolean);
+const javaHome = javaHomes.find((candidate) => {
+  const binary = path.join(candidate, "bin", process.platform === "win32" ? "java.exe" : "java");
+  const major = existsSync(binary) ? javaMajor(binary) : 0;
+  return major >= 21 && major <= 24;
+});
+if (!javaHome) {
+  console.error("A Gradle-compatible JDK 21–24 was not found. Install JDK 21 and set JAVA_HOME.");
+  process.exit(1);
+}
+const sdkRoot = firstExisting([
+  process.env.ANDROID_SDK_ROOT,
+  process.env.ANDROID_HOME,
+  process.platform === "win32" ? path.join(process.env.LOCALAPPDATA ?? "", "Android", "Sdk") : "",
+  path.join(home, "Android", "Sdk"),
+  "/opt/android-sdk",
+  "/usr/lib/android-sdk"
+]);
+if (!sdkRoot && !existsSync(path.join(androidDir, "local.properties"))) {
+  console.error("Android SDK was not found. Install SDK Platform 36 or configure ANDROID_SDK_ROOT.");
+  process.exit(1);
+}
+const buildEnv = { ...process.env, JAVA_HOME: javaHome, ...(sdkRoot ? { ANDROID_HOME: sdkRoot, ANDROID_SDK_ROOT: sdkRoot } : {}) };
+run(wrapper, ["bundleRelease"], { cwd: androidDir, env: buildEnv });
+
+const sourceAab = path.join(androidDir, "app", "build", "outputs", "bundle", "release", "app-release.aab");
+if (!existsSync(sourceAab)) {
+  console.error("Gradle completed but app-release.aab was not found.");
+  process.exit(1);
+}
+const outputDir = path.resolve("output/android");
+mkdirSync(outputDir, { recursive: true });
+const outputAab = path.join(outputDir, "EduPath-BD-v0.9.2-release.aab");
+copyFileSync(sourceAab, outputAab);
+const hash = createHash("sha256");
+await new Promise((resolve, reject) => createReadStream(outputAab).on("data", (chunk) => hash.update(chunk)).on("end", resolve).on("error", reject));
+console.log(`\nSigned AAB ready: ${outputAab}`);
+console.log(`SHA-256: ${hash.digest("hex")}`);
