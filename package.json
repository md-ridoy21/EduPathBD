{
  "name": "edupath-bd",
  "version": "1.1.0-rc.1",
  "private": true,
  "description": "AI-powered cross-platform education, admission and career decision support app for Bangladeshi students.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "postinstall": "npm run db:generate",
    "dev": "concurrently -n web,api -c cyan,green \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace @edupath/web",
    "dev:api": "npm run dev --workspace @edupath/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:ops",
    "test:ops": "node --test tests/ops/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "audit:critical": "npm audit --omit=dev --omit=optional --audit-level=critical",
    "audit:high": "npm run audit:runtime:high",
    "release:gate": "npm run qa && npm run test:e2e && npm run audit:runtime:high && npm run audit:tooling:critical",
    "audit:report": "npm audit --omit=dev || true",
    "qa": "npm run typecheck && npm test && npm run verify:model && npm run verify:api && npm run verify:release && npm run verify:production && npm run verify:security-scope && npm run build",
    "verify:api": "npm run build -w @edupath/api && node scripts/verify-api.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "model:train": "node scripts/train-pathway-model.mjs",
    "media:build-fallback": "node scripts/build-fallback-video.mjs",
    "verify:model": "node scripts/verify-pathway-model.mjs",
    "android:doctor": "node scripts/android-doctor.mjs",
    "android:prepare": "node scripts/build-android.mjs --prepare-only",
    "android:debug": "node scripts/build-android.mjs",
    "db:generate": "npm run db:generate --workspace @edupath/api",
    "db:migrate": "npm run db:migrate --workspace @edupath/api",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @edupath/api",
    "db:backup": "node scripts/database-backup.mjs",
    "db:restore": "node scripts/database-restore.mjs",
    "db:integrity": "node scripts/database-integrity.mjs",
    "admin:bootstrap": "npm run admin:bootstrap --workspace @edupath/api",
    "production:integrations-check": "npm run verify:integrations --workspace @edupath/api",
    "production:runtime-check": "node scripts/verify-production-runtime.mjs",
    "db:seed": "npm run db:seed --workspace @edupath/api",
    "db:seed:demo": "npm run db:seed:demo --workspace @edupath/api",
    "db:seed:repair": "npm run db:seed:repair --workspace @edupath/api",
    "db:studio": "npm run db:studio --workspace @edupath/api",
    "audit:runtime:high": "npm audit --omit=dev --omit=optional --audit-level=high --ignore GHSA-m9gg-hp2v-232j --ignore GHSA-f596-whhp-79r4",
    "audit:tooling:critical": "npm audit --audit-level=critical",
    "verify:security-scope": "node scripts/verify-security-scope.mjs",
    "data:import:official": "npm run data:import:official --workspace @edupath/api --"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^10.0.5"
  }
}
