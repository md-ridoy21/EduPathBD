NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost
DEMO_MODE=true
ALLOW_INSECURE_WEB_ORIGINS=false
TRUST_PROXY=false
LOG_REQUESTS=false
SHUTDOWN_TIMEOUT_MS=10000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edupath
JWT_SECRET=replace-with-a-long-random-secret
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# Deprecated fallback only; prefer SUPABASE_SECRET_KEY for new deployments.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=edupath-media
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Safer local alternative to pasting service-account JSON into an env value.
# Point this standard Google variable at an untracked JSON file readable only by the API process.
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Use true only with a fictional phone number/code configured in Firebase Console.
VITE_FIREBASE_PHONE_TEST_MODE=false
VITE_GUIDE_AUDIO_BN_URL=
VITE_GUIDE_AUDIO_EN_URL=
