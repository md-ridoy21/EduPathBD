@@ -0,0 +1,10 @@
+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import test from "node:test";
+
+test("database integrity recognizes the configured private media bucket", async () => {
+  const source = await readFile(new URL("../../scripts/database-integrity.mjs", import.meta.url), "utf8");
+  assert.match(source, /SUPABASE_STORAGE_BUCKET/);
+  assert.match(source, /supabase-storage:\/\/\$\{storageBucket\}\/\%/);
+  assert.match(source, /Verified media must use HTTPS or the configured private storage bucket/);
+});
diff --git a/tests/ops/production-seed-safety.test.mjs b/tests/ops/production-seed-safety.test.mjs
new file mode 100644
index 0000000..e8bc2ae
--- /dev/null
+++ b/tests/ops/production-seed-safety.test.mjs
@@ -0,0 +1,18 @@
+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import test from "node:test";
+
+test("production seed requires an explicit flag for demo community fixtures", async () => {
+  const [rootPackage, apiPackage, source] = await Promise.all([
+    readFile(new URL("../../package.json", import.meta.url), "utf8").then(JSON.parse),
+    readFile(new URL("../../apps/api/package.json", import.meta.url), "utf8").then(JSON.parse),
+    readFile(new URL("../../apps/api/prisma/seed.ts", import.meta.url), "utf8")
+  ]);
+
+  assert.equal(apiPackage.scripts["db:seed"], "tsx prisma/seed.ts");
+  assert.equal(apiPackage.scripts["db:seed:demo"], "tsx prisma/seed.ts --include-demo-content");
+  assert.match(rootPackage.scripts["db:seed:demo"], /db:seed:demo/);
+  assert.match(source, /process\.argv\.includes\("--include-demo-content"\)/);
+  assert.match(source, /if \(includeDemoContent\)/);
+  assert.match(source, /Skipped demo users, discussions, reports and ratings/);
+});
