+test("repository database commands load the API environment without overriding deployment values", async () => {
+  const [loader, backup, restore, integrity] = await Promise.all([
+    readFile(new URL("../../scripts/lib/load-api-env.mjs", import.meta.url), "utf8"),
+    readFile(new URL("../../scripts/database-backup.mjs", import.meta.url), "utf8"),
+    readFile(new URL("../../scripts/database-restore.mjs", import.meta.url), "utf8"),
+    readFile(new URL("../../scripts/database-integrity.mjs", import.meta.url), "utf8")
+  ]);
+
+  assert.match(loader, /apps\/api\/\.env/);
+  assert.match(loader, /override: false/);
+  for (const source of [backup, restore, integrity]) {
+    assert.match(source, /import "\.\/lib\/load-api-env\.mjs";/);
+  }
+});
+
